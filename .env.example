# Copy to .env.local and fill in values from Supabase Dashboard -> Project Settings -> API Keys.
# Only the public (publishable / anon) key belongs here, never the service_role / secret key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable-or-anon-key>
